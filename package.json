{
  "name": "westerville-lions",
  "version": "1.73.1",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "dotenv -e .env.local -- node drizzle/run-migrations.mjs && dotenv -e .env.local -- next dev",
    "build": "node drizzle/run-migrations.mjs && drizzle-kit push --force && next build",
    "build:only": "NEXT_PUBLIC_BUILD_TIME=$(date -u +%Y-%m-%dT%H:%M:%SZ) NEXT_PUBLIC_APP_VERSION=$(node -p \"require('./package.json').version\") next build",
    "db:migrate": "node drizzle/run-migrations.mjs",
    "db:push": "drizzle-kit push",
    "db:migrate-and-push": "node drizzle/run-migrations.mjs && drizzle-kit push",
    "db:import-roster": "tsx scripts/import-roster.ts",
    "db:sync-roster": "dotenv -e .env.local -- tsx scripts/sync-roster.ts",
    "db:update-member-details": "dotenv -e .env.local -- tsx scripts/update-member-details.ts",
    "db:add-events": "tsx scripts/add-events.ts",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "dotenv -e .env.local -- playwright test"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@marsidev/react-turnstile": "^1.5.3",
    "@radix-ui/react-alert-dialog": "^1.1.17",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-separator": "^1.1.10",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.15",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "googleapis": "^173.0.0",
    "libheif-js": "^1.19.8",
    "lucide-react": "^0.562.0",
    "next": "16.2.12",
    "next-auth": "5.0.0-beta.32",
    "postgres": "^3.4.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.80.0",
    "react-image-crop": "^11.0.10",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.16.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "pnpm": {
    "overrides": {
      "@auth/core": "0.41.3",
      "sharp@<0.35.0": ">=0.35.0",
      "minimatch": "^10",
      "postcss": ">=8.5.10",
      "qs": ">=6.15.2",
      "brace-expansion@>=3.0.0 <5.0.9": ">=5.0.9",
      "nanoid@<3.3.17": ">=3.3.17 <4",
      "browserslist@<4.28.7": ">=4.28.7"
    }
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@playwright/test": "^1.60.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/turndown": "^5.0.6",
    "@vitest/coverage-v8": "^4.1.9",
    "autoprefixer": "^10.5.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "postcss": "^8.5.24",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.9"
  }
}
