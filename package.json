{
  "name": "westerville-lions",
  "version": "1.18.3",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "dotenv -e .env.local -- node drizzle/run-migrations.mjs && dotenv -e .env.local -- next dev",
    "build": "node drizzle/run-migrations.mjs && drizzle-kit push --force && next build",
    "build:only": "NEXT_PUBLIC_BUILD_TIME=$(date -u +%Y-%m-%dT%H:%M:%SZ) NEXT_PUBLIC_APP_VERSION=$(node -p \"require('./package.json').version\") next build",
    "db:migrate": "node drizzle/run-migrations.mjs",
    "db:push": "drizzle-kit push",
    "db:migrate-and-push": "node drizzle/run-migrations.mjs && drizzle-kit push",
    "db:import-roster": "tsx scripts/import-roster.ts",
    "db:sync-roster": "dotenv -e .env.local -- tsx scripts/sync-roster.ts",
    "db:update-member-details": "dotenv -e .env.local -- tsx scripts/update-member-details.ts",
    "db:add-events": "tsx scripts/add-events.ts",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "dotenv -e .env.local -- playwright test"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.1",
    "@marsidev/react-turnstile": "^1.4.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "googleapis": "^169.0.0",
    "lucide-react": "^0.562.0",
    "next": "16.2.6",
    "next-auth": "5.0.0-beta.30",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.69.0",
    "react-image-crop": "^11.0.10",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.6.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "xlsx": "^0.18.5"
  },
  "pnpm": {
    "overrides": {
      "@auth/core": "0.41.1"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.6",
    "autoprefixer": "^10.4.24",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.6"
  }
}
