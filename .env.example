# Database
DATABASE_URL=postgresql://user:password@localhost:5432/westerville_lions

# Bootstrap: after your first sign-in, set this to your own account's email
# and re-run `pnpm db:migrate` to grant yourself admin/treasurer. Safe to
# leave unset. See CLAUDE.md -> Environment Variables.
SEED_ADMIN_EMAIL=

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-secret-key-here

# Google OAuth (Google for Nonprofits)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email (Resend - optional)
RESEND_API_KEY=your-resend-api-key

# Givebutter (optional - if using API)
GIVEBUTTER_API_KEY=your-givebutter-api-key

# Vercel Blob Storage — required in production for receipt file uploads (The Ledger — inc2)
# Without this, receipt files fall back to LocalReceiptStorage (ephemeral filesystem)
# and will be permanently lost on every redeployment.
# Obtain from: Vercel dashboard → Storage → Blob → your store → .env.local snippet
BLOB_READ_WRITE_TOKEN=

# ── One-off scripts and seeding ──────────────────────────────────────────
# The users.email row a one-off script attributes its writes to. Required by
# scripts/ that record an actor; they throw rather than guess. Set it to your
# own account.
SCRIPT_OPERATOR_EMAIL=

# Optional. Addresses shared by more than one member (a household on one
# mailbox), used by scripts that reconcile family dues. Unset = no-op.
SHARED_HOUSEHOLD_EMAIL=
